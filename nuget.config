<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>

	<!-- Central Package Management requires a package source mapping (or a single source),
	     otherwise restore raises NU1507 on machines with multiple feeds configured.
	     All packages used by this solution come from nuget.org. If you temporarily need a
	     package from the FirelyTeam GitHub feed, add a mapping for it here (do not commit). -->
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
